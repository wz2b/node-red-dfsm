    "id": "f44cecf8a6fc5d1f",
    "type": "dfsm-state-machine",
    "name": "FSM1",
    "states": "[\"RESET\",\"READY\",\"RUNNING\",\"CLEANUP\"]",
    "initialState": "RESET",
    "initialContext": "{}",
    "allowedTransitions": "[{\"from\":\"RESET\",\"to\":\"RESET\"},{\"from\":\"RESET\",\"to\":\"READY\"},{\"from\":\"READY\",\"to\":\"RUNNING\"},{\"from\":\"RUNNING\",\"to\":\"CLEANUP\"},{\"from\":\"CLEANUP\",\"to\":\"READY\"},{\"from\":\"READY\",\"to\":\"RESET\"}]"
