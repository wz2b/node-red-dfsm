  {
    "id": "comment-running",
    "type": "comment",
    "z": "tab-interval-example",
    "name": "RUNNING state handler — receives transition + interval emissions for RUNNING only",
    "info": "With skip policy and 2s interval:\n- First emission is the accepted transition (lifecycleType=active_transition, changed=true).\n- The cycle is now in-flight/unresolved.\n- Interval ticks fire every 2s but are skipped because a cycle is unresolved.\n- The cycle resolves when the next state-changing transition is accepted.\n\nWith queue_one policy:\n- The first interval tick that fires while in-flight is queued (queuedIntervalEmission=true).\n- Additional ticks while unresolved are coalesced (only one remains queued).\n- On cycle resolution (state changes), the queued emission is delivered if the resolved state matches.",
    "x": 330,
    "y": 540,
    "wires": []
  },
  {
    "id": "running-handler",
    "type": "function",
    "z": "tab-interval-example",
    "name": "RUNNING handler",
    "func": "const p = msg.dfsm || {};\nconst kind = p.lifecycleType || \"active_transition\";\nconst context = { ...(p.context || {}) };\n\nconst currentCount = Number.isFinite(context.count) ? context.count : 0;\nconst nextCount = currentCount + 1;\n\ncontext.count = nextCount;\n\n// Show status so the user can see what kind of activation happened\nif (kind === \"active_interval\") {\n    node.status({\n        fill: \"yellow\",\n        shape: \"ring\",\n        text: `interval: RUNNING count=${nextCount}`\n    });\n} else if (p.retrigger) {\n    node.status({\n        fill: \"blue\",\n        shape: \"dot\",\n        text: `retrigger: RUNNING count=${nextCount}`\n    });\n} else {\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: `entered RUNNING count=${nextCount}`\n    });\n}\n\n// Pass updated context forward\nmsg.dfsm = {\n    ...p,\n    context\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 700,
    "wires": [
      [
        "debug-running",
        "3e2097e64fcf550c"
      ]
    ]
  },
