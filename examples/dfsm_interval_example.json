  {
    "id": "classify-lifecycle",
    "type": "function",
    "z": "tab-interval-example",
    "name": "Classify lifecycle emission",
    "func": "const p = msg.dfsm || {};\nconst kind = p.lifecycleType || 'active_transition';\n\nif (kind === 'active_interval') {\n    node.status({ fill: 'yellow', shape: 'dot', text: `interval tick @ ${p.state}` });\n} else if (p.changed) {\n    node.status({ fill: 'green', shape: 'dot', text: `transition -> ${p.state}` });\n} else {\n    node.status({ fill: 'blue', shape: 'dot', text: `retrigger ${p.state}` });\n}\n\nmsg.topic = kind;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 440,
    "wires": [
      [
        "debug-lifecycle"
      ]
    ]
  },
