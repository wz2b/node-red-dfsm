[
  {
    "id": "tab-interval-example",
    "type": "tab",
    "label": "DFSM Interval Example",
    "disabled": false,
    "info": "Demonstrates config-owned interval scheduling with skip and queue_one policies.\n\nThe dfsm-state-machine owns the periodic active-lifecycle emissions.\nInterval emissions are lifecycle signals (lifecycleType = \"active_interval\"), not state transitions or retriggers.\n\nAn active cycle resolves only on a real state-changing accepted transition.\nSame-state retrigger requests do NOT resolve the cycle.\n\nPolicy behavior:\n  skip      - interval ticks that arrive while a cycle is in-flight are silently dropped.\n  queue_one - at most one pending emission is held; it is delivered on real cycle resolution if the state is unchanged.",
    "env": []
  },
  {
    "id": "comment-overview",
    "type": "comment",
    "z": "tab-interval-example",
    "name": "Interval scheduling owned by dfsm-state-machine. Policy: skip (fixed_rate, 5s).",
    "info": "The dfsm-state-machine config node owns the interval timer.\ndfsm-active subscribes to active-lifecycle emissions which include both\ntransition snapshots (lifecycleType=active_transition) and periodic\ninterval signals (lifecycleType=active_interval).\n\nAn in-flight cycle is started when a transition or interval emission is dispatched.\nWith 'skip' policy, interval ticks that fire while a cycle is unresolved are dropped.\nThe cycle resolves only when a state-changing transition is accepted.\n\nTo see queue_one behavior, change intervalPolicy to 'queue_one' on the config node.",
    "x": 400,
    "y": 40,
    "wires": []
  },
