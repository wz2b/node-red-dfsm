  },
  "devDependencies": {
    "@node-red/editor-api": "^4.1.8",
    "@node-red/nodes": "^4.1.8",
    "@node-red/registry": "^4.1.8",
    "@node-red/runtime": "^4.1.8",
    "eslint": "^8.0.0",
    "mocha": "^10.4.0",
    "node-red": "^4.0.2",
    "node-red-node-test-helper": "^0.3.4"
  },
  "dependenciesMeta": {
    "node-red@4.1.8": {
      "unplugged": true
