{
  "name": "@wz2b/node-red-dfsm",
  "version": "0.2.0",
  "description": "Distributed Finite State Machine toolbox for Node Red",
  "keywords": [
    "node-red",
    "fsm",
    "state-machine"
  ],
  "engines": {
    "node": ">=18.5"
