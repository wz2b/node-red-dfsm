    "type": "git",
    "url": "git+https://github.com/wz2b/node-red-dfsm"
  },
  "bugs": {
    "url": "https://github.com/wz2b/node-red-dfsm/issues"
  },
  "homepage": "https://github.com/wz2b/node-red-dfsm#readme",
  "author": "Christopher Piggott",
  "license": "MIT",
  "node-red": {
    "version": ">=3",
    "nodes": {
      "dfsm-config": "src/dfsm-config.js",
      "dfsm-activate": "src/dfsm-in.js",
      "dfsm-active": "src/dfsm-out.js",
      "dfsm-error": "src/dfsm-error.js",
      "dfsm-util-latch": "src/dfsm-util-latch.js",
      "dfsm-state-enter": "src/dfsm-state-enter.js",
      "dfsm-state-exit": "src/dfsm-state-exit.js"
